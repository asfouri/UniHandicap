<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.universite.controller.ColorVisionTestController"
            prefWidth="900" prefHeight="620"
            style="-fx-background-color: #F5F7FA;">

    <!-- En-tête -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <padding><Insets topRightBottomLeft="15"/></padding>
            <Label text="👁" style="-fx-font-size: 26px;"/>
            <VBox>
                <Label styleClass="header-titre" text="Test de Vision des Couleurs"/>
                <Label styleClass="header-sous-titre"
                       text="Ce test permet d'adapter l'interface à votre profil visuel"/>
            </VBox>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox alignment="CENTER" spacing="25">
            <padding><Insets topRightBottomLeft="50"/></padding>

            <!-- Indicateur d'étape -->
            <Label fx:id="labelEtape" text="Étape 1 / 3"
                   style="-fx-text-fill: #6C757D; -fx-font-size: 13px;"/>

            <!-- Question -->
            <Label fx:id="labelQuestion"
                   text="Quelle couleur voyez-vous principalement ?"
                   styleClass="label-titre"
                   wrapText="true" textAlignment="CENTER" maxWidth="600"/>

            <!-- Zone de test visuel (cercle de couleur) -->
            <StackPane fx:id="zoneTest"
                       prefWidth="200" prefHeight="200"
                       styleClass="zone-test-couleur"/>

            <!-- Boutons de réponse (générés dynamiquement par le contrôleur) -->
            <FlowPane fx:id="zoneReponses" alignment="CENTER" hgap="12" vgap="8" prefWrapLength="800">
                <padding><Insets topRightBottomLeft="5"/></padding>
            </FlowPane>

            <!-- Séparateur -->
            <Separator maxWidth="400"/>

            <!-- Bouton réponse vocale (option complémentaire, bien positionné) -->
            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="boutonRepondreVocalement"
                        text="🎤  Répondre par la voix"
                        onAction="#handleRepondreVocalement"
                        styleClass="button"/>

                <!-- Bouton Ignorer le test - restauré comme en V1 -->
                <Button fx:id="boutonPasser"
                        text="Ignorer ce test et continuer →"
                        onAction="#handlePasser"
                        styleClass="bouton-secondaire"
                        style="-fx-font-size: 12px;"/>
            </HBox>

            <Label text="ℹ Vous pourrez modifier vos préférences visuelles dans les paramètres."
                   style="-fx-text-fill: #6C757D; -fx-font-size: 11px;"
                   wrapText="true" textAlignment="CENTER" maxWidth="500"/>
        </VBox>
    </center>
</BorderPane>
